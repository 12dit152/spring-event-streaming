# ============================================================
# Grafana Cloud OTLP credentials
# Copy this file to .env and fill in your values.
# .env is git-ignored — never commit it.
# ============================================================

# Grafana Cloud OTLP gateway URL (no trailing slash, no /v1/*)
# Find yours at: https://grafana.com/profile/org -> "OTLP" section
GRAFANA_OTLP_ENDPOINT=https://otlp-gateway-prod-us-central-0.grafana.net/otlp

# Base64-encoded "instanceId:apiKey"
# 1. In Grafana Cloud, go to My Account -> Grafana Cloud Stack -> OpenTelemetry
# 2. Note your Instance ID (numeric) and generate an API key with MetricsPublisher role
# 3. Run:  echo -n "<instanceId>:<apiKey>" | base64
GRAFANA_OTLP_AUTH=<base64(instanceId:apiKey)>
